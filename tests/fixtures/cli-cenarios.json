{
    "schemaVersion": 1,
    "scenarios": [
        {
            "id": "ura",
            "name": "URA 8000",
            "accountId": "Sim 1001",
            "steps": [
                { "type": "register" },
                { "type": "dial", "to": "8000", "call": "c1" },
                { "type": "waitState", "call": "c1", "state": "established", "timeoutMs": 10000 },
                { "type": "dtmf", "call": "c1", "digits": "1234" },
                { "type": "verify", "call": "c1", "check": "log", "expected": "URA recebeu o dígito 4" },
                { "type": "hangup", "call": "c1" }
            ]
        },
        {
