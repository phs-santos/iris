{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "ignoreDeprecations": "6.0",
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "baseUrl": ".",
        "paths": {
            "@renderer/*": ["src/renderer/src/*"],
            "@shared/*": ["src/shared/*"]
        }
    },
    "include": [
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.vue",
        "src/preload/*.d.ts",
        "src/shared/**/*",
        "tests/**/*"
    ]
}
