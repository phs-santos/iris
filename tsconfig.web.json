{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "paths": {
            "@renderer/*": ["./src/renderer/src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    },
    "include": [
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.vue",
        "src/preload/*.d.ts",
        "src/shared/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "tests/sip-core.test.ts",
        "tests/app-log.test.ts",
        "tests/user-agent.test.ts",
        "tests/transport.test.ts"
    ]
}
