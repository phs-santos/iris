{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"],
        "paths": { "@shared/*": ["./src/shared/*"] }
    },
    "include": [
        "electron.vite.config.ts",
        "src/main/**/*",
        "src/preload/**/*",
        "src/shared/**/*",
        "tests/sip-core.test.ts",
        "tests/app-log.test.ts",
        "tests/user-agent.test.ts",
        "tests/transport.test.ts"
    ]
}
