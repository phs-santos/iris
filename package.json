{
    "name": "iris",
    "productName": "Iris",
    "version": "1.5.0",
    "description": "Softphone desktop para testes de telefonia: várias contas, vários PBX, log SIP lado a lado.",
    "main": "out/main/index.js",
    "license": "MIT",
    "author": "Paulo Souza",
    "homepage": "https://github.com/phs-santos/iris",
    "repository": {
        "type": "git",
        "url": "https://github.com/phs-santos/iris.git"
    },
    "private": true,
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "cenario": "electron .",
        "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . && node scripts/check-i18n.mjs",
        "dist": "electron-vite build && electron-builder --publish never",
        "dist:linux": "electron-vite build && electron-builder --linux --publish never",
        "dist:win": "electron-vite build && electron-builder --win --publish never",
        "dist:mac": "electron-vite build && electron-builder --mac --publish never",
        "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs",
        "test:scenarios": "electron-vite build && node tests/e2e/scenarios.mjs",
        "test:cli": "electron-vite build && node tests/e2e/cli.mjs",
        "test:a11y": "electron-vite build && node tests/e2e/a11y.mjs",
        "test:ai": "electron-vite build && node tests/e2e/ai.mjs",
        "test:senhas": "electron-vite build && node tests/e2e/senhas.mjs",
        "test:arquivos": "electron-vite build && node tests/e2e/arquivos.mjs",
        "test:pacote": "electron-vite build && node tests/e2e/pacote.mjs",
        "test:reconexao": "electron-vite build && node tests/e2e/reconexao.mjs",
        "test:sip": "electron-vite build && node tests/e2e/sip-puro.mjs",
        "test:pbx": "electron-vite build && node tests/e2e/asterisk.mjs",
        "test:load": "electron-vite build && node tests/e2e/load.mjs",
        "test:resources": "electron-vite build && node tests/e2e/resources.mjs",
        "icons": "electron scripts/make-icons.mjs",
        "guide:shots": "electron-vite build && node scripts/guide-shots.mjs",
        "postinstall": "node scripts/apply-patches.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "licenses": "node scripts/check-licenses.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.10.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitest/coverage-v8": "^4.1.11",
        "axe-core": "4.13.0",
        "easy-sipjs": "2.7.6",
        "electron": "^44.5.1",
        "electron-builder": "27.0.0-alpha.9",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "pinia": "^3.0.0",
        "playwright-core": "^1.63.0",
        "prettier": "3.9.9",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^7.0.0",
        "vitest": "^4.0.0",
        "vue": "^3.5.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.0.0"
    },
    "dependencies": {
        "electron-updater": "6.8.9"
    }
}
